# Vite Frontend Environment Variables
# API Base URL for Django REST Framework (defaults to dynamic window.location.hostname:8000/api if not specified)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT_MS=15000

# Blockchain Configuration
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Localhost

# Optional overrides. The deployment script also writes address/ABI configuration to src/contracts/contracts.json.
VITE_ELECTION_MANAGER_ADDRESS=
VITE_VOTER_ELIGIBILITY_ADDRESS=
VITE_LIGHT_VOTE_ADDRESS=
VITE_ELECTION_RESULTS_ADDRESS=
