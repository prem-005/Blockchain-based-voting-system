# ==============================================================
# LightVote - Environment Configuration Example
# Copy this file to .env and customize values for your deployment
# NEVER commit .env to version control!
# ==============================================================

# --- DJANGO BACKEND CONFIGURATION ---
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQLITE_PATH=backend/db.sqlite3

# --- EMAIL OTP CONFIGURATION (SMTP) ---
# Set to 'smtp' to enable real emails, or 'console' to print OTPs to backend stdout
EMAIL_BACKEND_TYPE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=LightVote Election Commission <noreply@lightvote.org>

# --- SMS OTP CONFIGURATION (OPTIONAL) ---
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=LGTVTE

# --- HARDHAT & BLOCKCHAIN CONFIGURATION ---
HARDHAT_NETWORK=localhost
HARDHAT_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
BALLOT_NULLIFIER_SECRET=replace-with-a-separate-random-secret

# --- DEPLOYED SMART CONTRACT ADDRESSES ---
# Automatically populated by scripts/deploy.js
VITE_ELECTION_MANAGER_ADDRESS=
VITE_VOTER_ELIGIBILITY_ADDRESS=
VITE_LIGHT_VOTE_ADDRESS=
VITE_ELECTION_RESULTS_ADDRESS=

# --- FRONTEND CLIENT ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_TIMEOUT_MS=15000
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
