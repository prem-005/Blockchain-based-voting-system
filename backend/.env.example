# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQLITE_PATH=db.sqlite3

# Email Backend Configuration (Set EMAIL_BACKEND_TYPE=console for local testing without SMTP)
EMAIL_BACKEND_TYPE=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=LightVote Election Commission <noreply@lightvote.org>

# Blockchain EVM RPC Configuration
HARDHAT_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
BALLOT_NULLIFIER_SECRET=replace-with-a-separate-random-secret
